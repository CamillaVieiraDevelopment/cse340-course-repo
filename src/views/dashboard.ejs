<%- include('partials/header') %>
    <main class="container">
        <h1>
            <%= title %>
        </h1>

        <%- include('partials/flash') %>

            <h2>Dashboard</h2>
            <p><strong>Name:</strong>
                <%= name %>
            </p>
            <p><strong>Username:</strong>
                <%= email %>
            </p>

            <hr>

            <!-- SECÇÃO DE PROJETOS VOLUNTARIADOS -->
            <div class="volunteered-projects" style="margin-top: 2rem;">
                <h3>My Volunteered Projects</h3>
                <% if (locals.volunteeredProjects && locals.volunteeredProjects.length> 0) { %>
                    <ul>
                        <% locals.volunteeredProjects.forEach(project=> { %>
                            <li style="margin-bottom: 10px;">
                                <a href="/project/<%= project.project_id %>">
                                    <%= project.title %>
                                </a>
                                (Date: <%= new Date(project.date).toLocaleDateString() %>)
                                    <br>
                                    <a href="/unvolunteer/<%= project.project_id %>"
                                        style="color: red; font-size: 0.9em;">Remove Volunteer</a>
                            </li>
                            <% }) %>
                    </ul>
                    <% } else { %>
                        <p>You haven't volunteered for any projects yet.</p>
                        <% } %>
            </div>

            <hr>

            <!-- Exibe o link APENAS se o usuário logado tiver a função 'admin' -->
            <% const userRole=(locals.user && (locals.user.role_name || locals.user.role)); %>
                <% if (userRole==='admin' ) { %>
                    <div class="admin-links" style="margin-top: 2rem;">
                        <h3>Ações de Administrador</h3>
                        <ul>
                            <li><a href="/users">Gerenciar Usuários (Listar Todos)</a></li>
                        </ul>
                    </div>
                    <% } %>
    </main>
    <%- include('partials/footer') %>