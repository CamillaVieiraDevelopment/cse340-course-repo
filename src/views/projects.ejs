<%- include('partials/header') %>
    <main>
        <h1>
            <%= title %>
        </h1>

        <ul>
            <% projects.forEach(project=> { %>
                <li>
                    <strong>
                        <%= new Date(project.date).toLocaleDateString() %>:
                    </strong>
                    <%= project.title %>
                        (<em>
                            <%= project.organization_name %>
                        </em>)
                </li>
                <% }); %>
        </ul>
    </main>
    <%- include('partials/footer') %>