<%- include('partials/header') %>
    <main>
        <h1>
            <%= title %>
        </h1>

        <!-- NEW: Link to add a new category -->
        <p><a href="/new-category">Create New Category</a></p>

        <p>Here are the project categories:</p>

        <ul>
            <% categories.forEach(category=> { %>
                <li>
                    <a href="/category/<%= category.category_id %>">
                        <%= category.name %>
                    </a>
                </li>
                <% }); %>
        </ul>
    </main>
    <%- include('partials/footer') %>